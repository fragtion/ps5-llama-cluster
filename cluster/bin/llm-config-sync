#!/bin/sh
# Push the small, often-edited config to the other console: /etc/litellm and /etc/llm-cluster.yaml.
# llm-config-sync.path starts this on every change, and llm-config-sync.timer catches up after the
# other console was away. Everything else stays with `llm-sync` (manual).
# Newer files win (--update) and nothing is deleted on the other console, so a console that was off
# with older copies can't overwrite newer edits. To delete a file, delete it on both.
# The copy that lands on the other console starts its own watcher, which applies it there
# (`llm-cluster ensure`) and finds nothing newer to send back.
sleep 2   # let an editor finish saving
/root/bin/llm-cluster ensure
peer=$(/root/bin/llm-cluster get peer.link)
cd /
out=$(rsync -aiR --update --exclude __pycache__ --exclude '.*.sw?' --exclude '*~' \
  -e "ssh -o BatchMode=yes -o ConnectTimeout=5" etc/litellm etc/llm-cluster.yaml "root@$peer:/" 2>&1)
rc=$?
stamp=$(date '+%F %T')
echo "$out" | grep -v '^\.d\.\.t' | grep . | sed "s/^/$stamp /"
[ $rc -eq 0 ] || echo "$stamp could not reach $peer (rsync exit $rc); the timer retries"
exit 0
