# /etc/litellm/env (mode 600): read by litellm.service. llm-sync copies it to the other console.
# Clients send this as their API key. Generate one with:
#   python3 -c 'import secrets; print("sk-" + secrets.token_urlsafe(24))'
LITELLM_MASTER_KEY=sk-change-me
# Vision model for `ps5` image requests while the pool is down (any OpenAI-compatible server)
VISION_FALLBACK_API_BASE=http://192.168.1.70:1234/v1
VISION_FALLBACK_MODEL=openai/<vision model id on that server>
# Text-only models behind the gateway whose images should become descriptions (comma-separated)
TEXT_ONLY_MODELS=
