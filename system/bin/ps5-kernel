#!/bin/sh
# Kernel updates for a PS5 running the ps5-linux image, without reflashing the drive. Installs one
# pinned release of github.com/ps5-linux/ps5-linux-patches; the deb's checksum is checked before
# anything changes.
#   ps5-kernel [status]   running kernel, installed package, what the next jailbreak boots
#   ps5-kernel install    install the pinned kernel in place of the running one; the next jailbreak
#                         boots it
#   ps5-kernel try        soft reboot (kexec) into the kernel the next jailbreak boots. No jailbreak
#                         needed.
# The jailbreak boots /boot/efi/bzImage and initrd.img; the deb's postinst copies the new kernel there.
set -e

VER=7.3.3 TAG=kernel-7.3.3-1472828
SHA=b5ee7308d73265d7f1d40d7c6bbf98d7aa4dc45451b2639ff854843b9d25a569

EFI=/boot/efi
DEBS=/root/kernel-debs

die() { echo "ps5-kernel: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root"; }
free_mb() { echo $(( $(df --output=avail -k "$1" | tail -1) / 1024 )); }

# fetch: the pinned release's deb in $DEBS, checked; prints its path
fetch() {
  f=$DEBS/linux-ps5_${VER}_amd64.deb
  mkdir -p $DEBS
  if ! echo "$SHA  $f" | sha256sum -c --status > /dev/null 2>&1; then
    echo "downloading linux-ps5 $VER ($TAG)" >&2
    wget -q -O "$f.part" "https://github.com/ps5-linux/ps5-linux-patches/releases/download/$TAG/linux-ps5_${VER}_amd64.deb" ||
      { rm -f "$f.part"; die "download failed"; }
    echo "$SHA  $f.part" | sha256sum -c --status || { rm -f "$f.part"; die "$f: wrong checksum"; }
    mv "$f.part" "$f"
  fi
  echo "$f"
}

# install_deb DEB: what `dpkg -i` does, but the postinst takes the newest directory in /lib/modules
# as the kernel to set up, so make sure the new kernel's directory is the newest before configuring.
install_deb() {
  export DEBIAN_FRONTEND=noninteractive
  dpkg --force-hold --unpack "$1"
  touch /lib/modules/$VER
  dpkg --force-hold --configure linux-ps5
  echo "linux-ps5 hold" | dpkg --set-selections   # the image holds it, so apt leaves the kernel alone
}

booting() {   # which kernel /boot/efi/bzImage is
  for f in /boot/vmlinuz-*; do
    [ -e "$f" ] && cmp -s $EFI/bzImage "$f" && { echo "${f#/boot/vmlinuz-}"; return; }
  done
  echo unknown
}

case "${1:-status}" in
  status)
    echo "running   $(uname -r)"
    echo "package   linux-ps5 $(dpkg-query -W -f='${Version} (${db:Status-Abbrev})' linux-ps5 2>/dev/null)"
    echo "next boot $(booting) (/boot/efi/bzImage)"
    echo "pinned    $VER ($TAG)" ;;

  install)
    need_root
    [ "$(uname -r)" != $VER ] || die "already running $VER"
    [ ! -e /lib/modules/$VER ] || die "/lib/modules/$VER exists already (ps5-kernel status)"
    mountpoint -q $EFI || die "$EFI isn't mounted"
    [ "$(free_mb /)" -ge 600 ] || die "needs 600 MB free on /, has $(free_mb /)"
    [ "$(free_mb $EFI)" -ge 50 ] || die "needs 50 MB free on $EFI, has $(free_mb $EFI)"
    install_deb "$(fetch)"
    cmp -s /boot/vmlinuz-$VER $EFI/bzImage && cmp -s /boot/initrd.img-$VER $EFI/initrd.img ||
      die "the postinst didn't set up $VER: check $EFI/bzImage and initrd.img before the next jailbreak!"
    echo
    echo "installed $VER; the next jailbreak boots it. To switch now: ps5-kernel try" ;;

  try)
    need_root
    [ -s $EFI/bzImage ] && [ -s $EFI/initrd.img ] || die "no $EFI/bzImage and initrd.img"
    kexec -l $EFI/bzImage --initrd=$EFI/initrd.img --command-line="$(cat $EFI/cmdline.txt)"
    echo "soft reboot into $(booting) (kexec)"
    systemctl kexec ;;

  *) echo "usage: ps5-kernel status|install|try"; exit 2 ;;
esac
